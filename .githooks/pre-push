#!/bin/sh
# Las puertas de este repo, corriendo solas antes de cada push.
#
# GitHub Actions esta DESHABILITADO a proposito -- repo privado, y el workflow
# figura como `disabled_manually`. Asi que esto no es un adelanto de otra
# puerta: es LA puerta. Si esto no corre, no corre nada.
#
# Y de paso cubre mas que el workflow: los dos guiones que necesitan el Python
# de KiCad salian HUECO en CI (instalar KiCad en el runner costaba mas de lo
# que cubria) y aqui corren de verdad, porque la maquina lo tiene.
#
# Instalar:   git config core.hooksPath .githooks
# Saltar:     git push --no-verify     (y decirlo en el PR)
#
# Tarda unos 60 s con la maquina libre y hasta ~80 s con carga: 58-60 s son
# gates.py y ~2 s las otras seis etapas con el target de cargo caliente
# (medido 2026-09-02). Dentro de gates.py el que manda es clearance_budget.py
# del case con 35 s; check_pcb.py de la fuente ocupa 1.0 s y sus canarios
# 8.1 s.
set -u

# Un push de BORRADO no lleva codigo: git pasa el oid local en ceros. Correr
# un minuto de puertas para borrar una rama YA mergeada no verifica
# nada, y ensena a empujar con --no-verify -- que es justo el habito que estas
# puertas existen para no crear.
#
# stdin de un pre-push es una linea por ref (githooks(5)):
#     <ref_local> <oid_local> <ref_remoto> <oid_remoto>
# En un borrado, <ref_local> es "(delete)" y <oid_local> son 40 ceros.
#
# Se salta SOLO si TODAS las lineas son borrados: un push mixto lleva codigo y
# se verifica entero. Y sin stdin no se salta nada, para que correr esto a mano
# (`sh .githooks/pre-push < /dev/null`) siga probando las puertas de verdad.
solo_borrados=1
hubo_ref=0
while read -r _ref oid_local _resto; do
    hubo_ref=1
    case "$oid_local" in
        *[!0]*) solo_borrados=0 ;;
    esac
done

if [ "$hubo_ref" = 1 ] && [ "$solo_borrados" = 1 ]; then
    echo ""
    echo "push de borrado: no hay codigo nuevo que verificar, puertas omitidas"
    echo ""
    exit 0
fi

RAIZ=$(git rev-parse --show-toplevel)
LOG=$(mktemp -d 2>/dev/null || echo "${TMPDIR:-/tmp}/prepush.$$")
mkdir -p "$LOG"
rojos=0
sin_correr=0

echo ""
echo "puertas locales -- Actions esta apagado, esto ES la puerta (~60s)"
echo ""

# corre <nombre> <comando-como-funcion>
corre() {
    nombre=$1
    printf '  %-22s ' "$nombre"
    if "$2" > "$LOG/$nombre.log" 2>&1; then
        echo "OK"
    else
        echo "ROJO"
        sed 's/^/      /' "$LOG/$nombre.log" | tail -20
        rojos=$((rojos + 1))
    fi
}

# falta <nombre> <razon>
falta() {
    printf '  %-22s NO-CORRIDO   %s\n' "$1" "$2"
    sin_correr=$((sin_correr + 1))
}

g_hardware() { cd "$RAIZ" && python hardware/tools/gates.py; }
# Hasta el #194 ruff solo miraba software/midi-cv: 30 de 113 guiones. Los 83
# de fuera eran justo los *_budget.py y check_*.py que deciden hardware, y el
# propio gates.py que los ejecuta. Ejecutar no es lintar: en diez dias la deuda
# de fuera paso de 29 errores a 68 sin que nada la viera. Desde la raiz ruff
# respeta .gitignore, asi que los worktrees de .claude/ no entran; las reglas
# viven en ruff.toml.
g_pytest()   { cd "$RAIZ/software/midi-cv" && python -m pytest -q; }
g_cargo()    { cd "$RAIZ/software/nucleo" && cargo test --workspace --quiet; }
g_clippy()   { cd "$RAIZ/software/nucleo" && cargo clippy --workspace --all-targets -- -D warnings; }
g_fmt()      { cd "$RAIZ/software/nucleo" && cargo fmt --all --check; }
# `fw` esta EXCLUIDO del workspace (software/nucleo/Cargo.toml: exclude=["fw"])
# porque compila para thumbv8m y `core` para el host. Consecuencia que nadie
# habia notado: `cargo test --workspace` NUNCA lo compilaba, asi que el
# firmware -- la mitad que de verdad se flashea -- no lo miraba ninguna puerta.
# Lo caza la junta adversarial del 2026-08-24 (Serrano, BLOCKER 1).
#
# Y va con `build --release`, no con `check`: `check` no ENLAZA, y desde el
# pase al N657 (#250) el enlace es justo lo que se puede romper. El mapa de
# `memory.x` reserva 256 K de AXISRAM2 para el codigo y el binario de
# depuracion se pasa 48 KB; con `check` esa puerta salia verde sin que
# existiera un binario. `--release` es ademas el unico perfil que EN-PLACA.md
# manda flashear.
g_fw()       { cd "$RAIZ/software/nucleo/fw" && cargo build --release --quiet; }

corre hardware g_hardware

# ruff puede estar en el PATH o solo como modulo de Python (`pip install ruff`
# sin la carpeta de scripts en el PATH). El 18-09 llevaba semanas NO-CORRIDO
# por eso, con ruff 0.15 instalado: el lint no corria en ningun push desde esta
# maquina y nadie lo veia. Se prueban las dos formas antes de darlo por ausente.
if command -v ruff > /dev/null 2>&1; then
    g_ruff()     { cd "$RAIZ" && ruff check .; }
    corre ruff g_ruff
elif python -m ruff --version > /dev/null 2>&1; then
    g_ruff()     { cd "$RAIZ" && python -m ruff check .; }
    corre ruff g_ruff
else
    falta ruff "pip install ruff"
fi
corre pytest g_pytest

# software/nucleo no lo cubria NADIE hasta el issue #173: ni CI ni esta puerta.
#
# Y ojo con clippy y rustfmt: `command -v cargo` los da por buenos y son
# COMPONENTES aparte. La primera corrida de este hook bloqueo un push porque
# rustfmt no estaba instalado -- que es un NO-CORRIDO, no un rojo. Se pregunta
# por cada subcomando, no por cargo.
if command -v cargo > /dev/null 2>&1; then
    corre cargo-test g_cargo
    if cargo clippy --version > /dev/null 2>&1; then
        corre cargo-clippy g_clippy
    else
        falta cargo-clippy "rustup component add clippy"
    fi
    if cargo fmt --version > /dev/null 2>&1; then
        corre cargo-fmt g_fmt
    else
        falta cargo-fmt "rustup component add rustfmt"
    fi
    # El firmware va aparte: otro target y otro workspace.
    if rustup target list --installed 2>/dev/null | grep -q thumbv8m.main-none-eabihf; then
        corre firmware g_fw
    else
        falta firmware "rustup target add thumbv8m.main-none-eabihf"
    fi
else
    falta cargo-test "instala Rust: https://rustup.rs"
    falta cargo-clippy "instala Rust: https://rustup.rs"
    falta cargo-fmt "instala Rust: https://rustup.rs"
    falta firmware "instala Rust: https://rustup.rs"
fi

echo ""
if [ "$rojos" -gt 0 ]; then
    echo "PUSH BLOQUEADO: $rojos en rojo. Los logs completos en $LOG"
    echo "Si sabes lo que haces: git push --no-verify (y dilo en el PR)"
    echo ""
    exit 1
fi

# ponytail: un NO-CORRIDO avisa pero no bloquea. Bloquear a quien empuja un
# cambio de documentacion desde una maquina sin Rust ensena a usar --no-verify,
# que es peor que el hueco. Subirlo a bloqueante el dia que haya mas de una
# maquina tocando firmware.
if [ "$sin_correr" -gt 0 ]; then
    echo "PUERTAS EN VERDE, con $sin_correr sin correr (arriba dice cual y como)."
else
    echo "PUERTAS EN VERDE."
fi
echo ""
exit 0
