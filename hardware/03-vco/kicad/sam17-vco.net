			(title_block
				(title "Modulo 03 - VCO x4 SSI2130: alimentacion, referencia y 4 voces")
				(company "SAM17 - Sintetizador analogico modular")
				(rev "A")
				(date "2026-08-16")
				(source "sam17-vco.kicad_sch")
				(comment
					(number "1")
					(value "V+ local a 5V (U11) y 3V3 (U12), no a los 12V del bus: ni el DAC ni la ref los aguantan")
				)
				(comment
					(number "2")
					(value "Referencia UNICA (U8, ADR4525): la interna de cada DAC se apaga por firmware, reg 0111")
				)
				(comment
					(number "3")
					(value "Trimless: precision de R_PITCH/R_SCALE fijas + ref 2ppm/C, no un trimmer de fabrica")
				)
				(comment
					(number "4")
					(value "GNDA (bus, J1) y GNDD (mazo digital, J2 en Tarea 3) NO se unen en esta placa")
				)
				(comment
					(number "5")
					(value "")
				)
