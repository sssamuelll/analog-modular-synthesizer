		(libpart
			(lib "sam17")
			(part "SSI2130")
			(description "VCO FatKeys completo: nucleo triangulo/diente de sierra/pulso, conformador de seno, mezclador de 5 canales y conversor exponencial. QFN-32 4x4mm con pad termico (pin 33 = EP): el land del PCB, si existe, va AISLADO -- sin red, sin via, sin plano -- el datasheet pag.6 (Exposed Thermal Pad) dice que NO debe llevar conexion electrica ni de masa. Orden de los pines 9-13 (MIX TRI, MIX SAW, MIX PULSE, MIX AUX1, MIX AUX2) verificado contra la Figure 1 (Typical Application Circuit) del datasheet, pag.5 -- coincide con la serigrafia de la Figure 1, NO con el orden alfabetico de las senales.")
			(docs "https://www.soundsemiconductor.com/ssi2130")
			(fields
				(field
					(name "Reference") "U")
				(field
					(name "Value") "SSI2130")
				(field
					(name "Footprint") "Package_DFN_QFN:QFN-32-1EP_4x4mm_P0.4mm_EP2.6x2.6mm")
				(field
					(name "Datasheet") "https://www.soundsemiconductor.com/ssi2130")
				(field
					(name "Description") "VCO FatKeys completo: nucleo triangulo/diente de sierra/pulso, conformador de seno, mezclador de 5 canales y conversor exponencial. QFN-32 4x4mm con pad termico (pin 33 = EP): el land del PCB, si existe, va AISLADO -- sin red, sin via, sin plano -- el datasheet pag.6 (Exposed Thermal Pad) dice que NO debe llevar conexion electrica ni de masa. Orden de los pines 9-13 (MIX TRI, MIX SAW, MIX PULSE, MIX AUX1, MIX AUX2) verificado contra la Figure 1 (Typical Application Circuit) del datasheet, pag.5 -- coincide con la serigrafia de la Figure 1, NO con el orden alfabetico de las senales.")
			)
