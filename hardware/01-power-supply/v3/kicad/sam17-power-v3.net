				(comment
					(number "1")
					(value "Variante Europa: primario 230VAC/50Hz. Pre-reg LM2941/LM2991 -> +13V1/-12V9")
				)
				(comment
					(number "2")
					(value "Primario: fusible + MOV S20K275 + NTC soft-start + J7 (SMPS digital, spec S7)")
				)
				(comment
					(number "3")
					(value "PE: J3.3 al esparrago de chasis; GND al mismo punto via J5 (S13)")
				)
				(comment
					(number "4")
					(value "v3: sin crowbar (issue #118). Isla de telemetria U8-U12 en GNDA, aislada por U12")
